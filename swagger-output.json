{
  "openapi": "3.0.0",
  "info": {
    "title": "Tasteorama API",
    "version": "1.0.0",
    "description": "Повнофункціональний API для управління рецептами, інгредієнтами та улюбленими рецептами. Включає аутентифікацію користувачів, управління профілем, створення та пошук рецептів.",
    "contact": {
      "name": "Tasteorama Support",
      "email": "support@tasteorama.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000/"
    },
    {
      "url": "https://localhost:3000/"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Endpoints для аутентифікації користувачів"
    },
    {
      "name": "Users",
      "description": "Endpoints для управління профілем користувача"
    },
    {
      "name": "Recipes",
      "description": "Endpoints для управління рецептами"
    },
    {
      "name": "Favorites",
      "description": "Endpoints для управління улюбленими рецептами"
    },
    {
      "name": "Categories",
      "description": "Endpoints для отримання категорій рецептів"
    },
    {
      "name": "Ingredients",
      "description": "Endpoints для отримання списку інгредієнтів"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Реєстрація нового користувача",
        "description": "Створити новий акаунт користувача",
        "responses": {
          "201": {
            "description": "Created - Користувач успішно зареєстрований"
          },
          "400": {
            "description": "Bad Request - Email вже існує або некоректні дані"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "example": "any"
                  },
                  "email": {
                    "example": "any"
                  },
                  "password": {
                    "example": "any"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Вхід в акаунт",
        "description": "Аутентифікація користувача",
        "responses": {
          "200": {
            "description": "OK - Успішний вхід"
          },
          "401": {
            "description": "Unauthorized - Невірні облікові дані"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "example": "any"
                  },
                  "password": {
                    "example": "any"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Оновлення сесії",
        "description": "Оновити JWT токени сесії користувача",
        "responses": {
          "200": {
            "description": "OK - Сесія успішно оновлена"
          },
          "401": {
            "description": "Unauthorized - Відсутні облікові дані або сесія закінчилася"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Вихід з акаунта",
        "description": "Вихід з акаунта та очищення сесії",
        "responses": {
          "204": {
            "description": "No Content - Успішний вихід"
          },
          "401": {
            "description": "Unauthorized - Не аутентифіковано"
          }
        }
      }
    },
    "/users/current/": {
      "get": {
        "tags": ["Users"],
        "summary": "Отримати інформацію про поточного користувача",
        "description": "Отримати дані поточно аутентифікованого користувача (вимагає аутентифікації)",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK - Успішно отримана інформація користувача"
          },
          "401": {
            "description": "Unauthorized - Користувач не аутентифікований"
          }
        }
      }
    },
    "/api/recipes": {
      "get": {
        "tags": ["Recipes"],
        "summary": "Отримати всі рецепти",
        "description": "Отримати рецепти з фільтруванням, поиском та пагінацією",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ingredient",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/recipes/{recipeId}": {
      "get": {
        "description": "",
        "parameters": [
          {
            "name": "recipeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
